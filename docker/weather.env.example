# Example env file for the weather-tracking compose project.
#
# Copy this to docker/weather.env (gitignored — real secrets never get
# committed) and fill in real values:
#   cp docker/weather.env.example docker/weather.env
#
# docker-compose.yml loads docker/weather.env via `env_file:` on the
# tracker and web services, and reads a few of these same variables
# directly for host-port/bind interpolation (documented below).
#
# Every variable below is a placeholder — no real API keys, no real
# locations.

# --- Secrets -----------------------------------------------------------

# OpenWeather API key used by the tracker to poll current conditions.
# Placeholder only — get a real key from https://openweathermap.org/api.
CLIMATE_OPENWEATHER_API_KEY=REPLACE_WITH_OPENWEATHER_KEY

# Israel Meteorological Service (IMS) API token, used by the tracker for
# IMS-sourced observations. Placeholder only.
CLIMATE_IMS_API_TOKEN=REPLACE_WITH_IMS_TOKEN

# --- Storage -------------------------------------------------------------

# Mongo connection string used by both tracker and web. Points at the
# compose-network service name, NOT localhost — weather-mongodb publishes
# no host port by default, so this is only reachable from other containers
# on the same compose network.
WEATHER_MONGO_URI=mongodb://weather-mongodb:27017/weather

# --- Web service bind/port ------------------------------------------------

# Host interface the web service's HTTP port is published on. Defaults to
# 127.0.0.1 (loopback-only) in docker-compose.yml if unset here.
CLIMATE_WEB_BIND=127.0.0.1

# Host port the web service is published on (container always listens on
# 8790 internally). Defaults to 8790 in docker-compose.yml if unset here.
CLIMATE_WEB_PORT=8790

# --- Config mount ---------------------------------------------------------

# Host directory containing the user's weather config (locations, alert
# thresholds, etc). Mounted read-only into both the tracker and web
# containers at /app/config. Defaults to ./config (relative to this repo)
# in docker-compose.yml if unset here.
CLIMATE_WEATHER_CONFIG_DIR=./config

# --- Optional debug mongo publish -----------------------------------------

# By default, weather-mongodb is NOT reachable from the host at all. To
# temporarily expose it on host port 27020 for local debugging (e.g. a
# GUI mongo client), bring up the debug-mongo compose profile instead of
# setting anything here:
#   docker compose --profile debug-mongo up -d weather-mongodb-debug
# There is no env var to flip for this on purpose — the profile keeps the
# debug publish an explicit, opt-in command rather than a config value that
# could be left on accidentally.
